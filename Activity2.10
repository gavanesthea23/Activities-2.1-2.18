public class IncrementDecrement
{
    public static void main(String[] args)
    {
        int i = 1, j;

        j = ++i;
        System.out.println("Pre-increment: j = " + j + ", i = " + i);

        i = 1;
        j = i++;
        System.out.println("Post-increment: j = " + j + ", i = " + i);
    }
}